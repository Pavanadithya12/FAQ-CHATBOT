# Backend API base URL (Default for local running: http://localhost:8000)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Default similarity threshold override (0.0 to 1.0)
NEXT_PUBLIC_DEFAULT_THRESHOLD=0.50
