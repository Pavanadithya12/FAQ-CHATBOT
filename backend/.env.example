# ==============================================================================
# FAQ CHATBOT ENTERPRISE — BACKEND CONFIGURATION
# File: backend/.env.example
# How to use: Rename this file to ".env" and fill in your actual API keys.
# NEVER commit your real .env file to GitHub!
# ==============================================================================

# ─── PINECONE (Cloud Vector Database — Optional) ──────────────────────────────
# What it does: Stores 1500-dimensional FAQ embeddings in the cloud for fast
#               semantic search (cosine similarity) across all FAQ vectors.
# How to get: Sign up FREE at https://www.pinecone.io/
#   Step 1: Create account → Create Index
#   Step 2: Index Name = "faq-chatbot", Dimensions = 1500, Metric = "cosine"
#   Step 3: Copy API Key from Console → paste below
# NOTE: If left blank, the app uses a built-in in-memory vector store (works offline!)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=faq-chatbot

# ─── VECTOR EMBEDDING SETTINGS (DO NOT CHANGE) ────────────────────────────────
# Boss requirement: 1500-dimensional embeddings for enterprise-grade vector search.
# Fallback: Custom offline n-gram hash vectorizer (no GPU, no internet needed).
EMBEDDING_DIMENSION=1500
EMBEDDING_MODEL=text-embedding-3-small

# ─── OPENAI API (Optional — Enhances Response Quality) ────────────────────────
# What it does: Uses OpenAI text-embedding-3-small for TRUE 1500-dim embeddings
#               AND uses GPT-4o for polished, conversational response writing.
# How to get: Sign up at https://platform.openai.com/api-keys
#   Step 1: Create account → Billing → Add payment method
#   Step 2: API Keys → Create new secret key → Copy below
# NOTE: If left blank, the chatbot runs fully offline using built-in vectorizer.
OPENAI_API_KEY=

# ─── GROQ API (Optional — Ultra-fast Free LLM) ────────────────────────────────
# What it does: Uses Groq LLaMA-3 for blazing-fast response writing (60 tokens/sec).
# How to get: Sign up FREE at https://console.groq.com/keys
#   Step 1: Create account → API Keys → Create New Key → Copy below
# NOTE: Completely free tier available. Faster than OpenAI for most use cases.
GROQ_API_KEY=

# ─── GOOGLE GEMINI API (Optional — Google AI Response Writer) ─────────────────
# What it does: Uses Google Gemini 1.5 Flash for smart FAQ answer formatting.
# How to get: Go to https://aistudio.google.com/app/apikey
#   Step 1: Sign in with Google → Create API Key → Copy below
# NOTE: Free tier available with generous usage limits.
GEMINI_API_KEY=

# ─── JWT AUTHENTICATION (Required — DO NOT CHANGE IN PRODUCTION) ──────────────
# What it does: Signs and verifies user login tokens (JSON Web Tokens / HS256).
#               Change JWT_SECRET_KEY to a strong random string in production!
# Generate a strong key: https://jwtsecret.com/generate
JWT_SECRET_KEY=enterprise-faq-chatbot-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── PIPELINE & RUNTIME SETTINGS ──────────────────────────────────────────────
# SIMILARITY_THRESHOLD: Minimum cosine similarity required before answering.
#   Range: 0.0 to 1.0 | Recommended: 0.50 (strict) or 0.40 (more lenient)
#   Higher = fewer but more accurate answers | Lower = more answers, less precise
SIMILARITY_THRESHOLD=0.50
PORT=8000
HOST=0.0.0.0


