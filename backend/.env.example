# ==============================================================================
# FAQ CHATBOT ENTERPRISE CONFIGURATION
# ==============================================================================

# ─── PINECONE (Vector Database) ───────────────────────────────────────────────
# Sign up at: https://www.pinecone.io/
# When creating your Pinecone Index, set Dimension to 1500 and Metric to 'cosine'
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=faq-chatbot

# ─── VECTOR EMBEDDINGS (Dimension: 1500) ──────────────────────────────────────
# Boss requirement: Set to 1500 dimensions (compatible with OpenAI text-embedding-3-small
# or high-capacity vector spaces). Built-in fallback generates normalized 1500-dim vectors offline.
EMBEDDING_DIMENSION=1500
EMBEDDING_MODEL=text-embedding-3-small

# ─── JWT AUTHENTICATION (User Login / Signup / Session) ────────────────────────
# Secret key used to sign and verify JSON Web Tokens (keep this private!)
JWT_SECRET_KEY=enterprise-faq-chatbot-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LLM / AI PROVIDERS (Optional: OpenAI, Groq, Gemini) ─────────────────────
# If left blank, the chatbot uses its verified, grounded answer writer without hallucinations.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── PIPELINE & RUNTIME SETTINGS ──────────────────────────────────────────────
# Minimum cosine similarity confidence score (0.0 to 1.0) before triggering fallback
SIMILARITY_THRESHOLD=0.50
PORT=8000
HOST=0.0.0.0

