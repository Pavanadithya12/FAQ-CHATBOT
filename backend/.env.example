# ==============================================================================
# FAQ CHATBOT ENTERPRISE — BACKEND CONFIGURATION
# File: backend/.env.example
# ==============================================================================
# 🤖 EXACT MODELS USED IN THIS PROJECT:
# 1. EMBEDDING MODEL: text-embedding-3-small (1500 Dimensions, OpenAI)
#    - Purpose: Encodes questions into 1500-dim vectors for Pinecone search.
# 2. LLM (GENERATION): gpt-4o-mini (OpenAI)
#    - Purpose: Generates conversational, grounded answers from matched FAQs.
# ==============================================================================

# ─── PINECONE (Cloud Vector Database — Optional) ──────────────────────────────
# What it does: Stores 1500-dimensional FAQ embeddings in the cloud for fast
#               semantic search (cosine similarity) across all FAQ vectors.
# How to get: Sign up FREE at https://www.pinecone.io/
#   Step 1: Create account → Create Index
#   Step 2: Index Name = "faq-chatbot", Dimensions = 1500, Metric = "cosine"
#   Step 3: Copy API Key from Console → paste below
# NOTE: If left blank, the app uses a built-in in-memory vector store (works offline!)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=faq-chatbot

# ─── VECTOR EMBEDDING MODEL (Dimension: 1500) ─────────────────────────────────
# Embedding Model: Converts user questions into 1500-dimensional mathematical vectors.
# Model Name: "text-embedding-3-small" (OpenAI third-generation embedding model)
# Offline Fallback: Custom 1500-dim n-gram hash vectorizer (runs if no API key)
EMBEDDING_DIMENSION=1500
EMBEDDING_MODEL=text-embedding-3-small

# ─── LLM 1: OPENAI (Large Language Model for Response Generation) ────────────
# LLM Model Name: "gpt-4o-mini" (or "gpt-4o", "gpt-3.5-turbo")
# What it does: Synthesizes grounded, human-like answers strictly from matched FAQs.
# How to get: https://platform.openai.com/api-keys
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ─── LLM 2: GROQ (Ultra-Fast Open Source LLM Provider) ────────────────────────
# LLM Model Name: "llama-3.1-8b-instant" (Meta's LLaMA 3.1 8B, runs at ~300 tokens/sec)
# What it does: Blazing fast grounded answer generation via Groq LPU chips.
# How to get: FREE at https://console.groq.com/keys
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# ─── LLM 3: GOOGLE GEMINI (Google AI LLM Provider) ────────────────────────────
# LLM Model Name: "gemini-1.5-flash" (Google DeepMind multimodal lightweight model)
# What it does: High-speed, context-aware grounded FAQ answer writing.
# How to get: FREE at https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# ─── JWT AUTHENTICATION (Required — DO NOT CHANGE IN PRODUCTION) ──────────────
# What it does: Signs and verifies user login tokens (JSON Web Tokens / HS256).
#               Change JWT_SECRET_KEY to a strong random string in production!
# Generate a strong key: https://jwtsecret.com/generate
JWT_SECRET_KEY=enterprise-faq-chatbot-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── PIPELINE & RUNTIME SETTINGS ──────────────────────────────────────────────
# SIMILARITY_THRESHOLD: Minimum cosine similarity required before answering.
#   Range: 0.0 to 1.0 | Recommended: 0.50 (strict) or 0.40 (more lenient)
#   Higher = fewer but more accurate answers | Lower = more answers, less precise
SIMILARITY_THRESHOLD=0.50
PORT=8000
HOST=0.0.0.0


