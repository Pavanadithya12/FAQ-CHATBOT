# ==============================================================================
# FAQ CHATBOT ENTERPRISE — MASTER ENVIRONMENT CONFIGURATION
# File: .env.example
# ==============================================================================
# 🤖 EXACT AI MODELS CONFIGURED IN THIS PROJECT:
#
# 1. VECTOR EMBEDDING MODEL:
#    - Model Name:  text-embedding-3-small
#    - Provider:    OpenAI
#    - Dimensions:  1500 Dimensions (Enterprise high-capacity vector space)
#    - Purpose:     Encodes user questions into 1500-dim vectors for Pinecone search.
#    - Fallback:    Custom deterministic 1500-dim n-gram hash vectorizer (offline).
#
# 2. LARGE LANGUAGE MODEL (LLM):
#    - Model Name:  gpt-4o-mini
#    - Provider:    OpenAI
#    - Temperature: 0.2 (Strictly grounded on FAQ context to prevent hallucinations)
#    - Purpose:     Generates natural, polite conversational answers from matched FAQs.
#    - Fallback:    Structured deterministic grounded answer formatter (offline).
# ==============================================================================

# ─── 1. PINECONE (Vector Database Settings) ───────────────────────────────────
# Where to get: Sign up FREE at https://www.pinecone.io/
# When creating index: Name="faq-chatbot", Dimensions=1500, Metric="cosine"
# (If left blank, system automatically uses built-in in-memory cosine vector store)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=faq-chatbot

# ─── 2. VECTOR EMBEDDING MODEL SETTINGS ───────────────────────────────────────
# Dimension must be set to 1500 as per enterprise specifications
EMBEDDING_DIMENSION=1500
EMBEDDING_MODEL=text-embedding-3-small

# ─── 3. LLM RESPONSE GENERATION MODEL SETTINGS ────────────────────────────────
# Primary LLM used for answering user queries strictly from matched FAQs
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# ─── 4. JWT AUTHENTICATION (User Login & Security) ────────────────────────────
# Secret key used to sign and verify JSON Web Tokens (HS256)
JWT_SECRET_KEY=enterprise-faq-chatbot-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── 5. PIPELINE & CONFIDENCE THRESHOLD SETTINGS ──────────────────────────────
# Minimum cosine similarity confidence score required before returning an answer.
# Range: 0.0 to 1.0 | Default: 0.50 (Matches below 0.50 trigger Fallback Handler)
SIMILARITY_THRESHOLD=0.50
PORT=8000
HOST=0.0.0.0

# ─── 6. FRONTEND API SETTINGS (Next.js) ───────────────────────────────────────
# Points frontend to the FastAPI backend API server
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_THRESHOLD=0.50
